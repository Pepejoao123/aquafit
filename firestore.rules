rules_version = '2';
// Regras do Firestore do FitPro: cada usuário só lê e grava os próprios dados.
// Cole em Firebase Console → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
